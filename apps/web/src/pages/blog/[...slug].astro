---
import Base from "../../layouts/Base.astro";
import { getCollection, render } from "astro:content";
import {
  blogPostSchema,
  breadcrumbSchema,
  readingTimeMinutes,
} from "../../lib/seo";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

// zh-CN posts live under src/content/blog/zh-cn/<slug>.md — the glob
// loader turns that into id "zh-cn/<slug>", which routes here as
// /blog/zh-cn/<slug>/. The locale prefix is stripped to find the
// translation twin (same slug, other locale).
const ZH_PREFIX = "zh-cn/";
const isZh = post.id.startsWith(ZH_PREFIX);
const lang = isZh ? "zh-CN" : "en";
const baseSlug = isZh ? post.id.slice(ZH_PREFIX.length) : post.id;

function formatDate(d: Date) {
  return d.toLocaleDateString(isZh ? "zh-CN" : "en-US", { year: "numeric", month: "long", day: "numeric" });
}

const ui = isZh
  ? { home: "首页", blog: "博客", minRead: "分钟阅读", relatedPosts: "相关文章", allPosts: "← 全部文章", rss: "RSS 订阅", updated: "更新于" }
  : { home: "Home", blog: "Blog", minRead: "min read", relatedPosts: "Related posts", allPosts: "← All posts", rss: "Subscribe via RSS", updated: "updated" };

const minutes = readingTimeMinutes(post.body ?? "");
const slug = post.id;
const blogIndex = isZh ? "/blog/zh-cn/" : "/blog/";

const allPosts = await getCollection("blog", ({ data }) => !data.draft);

// Translation twin: same slug under the other locale. hreflang links
// only ship when both pages actually exist — a zh post without its EN
// twin still renders, it just doesn't advertise a dead alternate.
const enTwinId = baseSlug;
const zhTwinId = `${ZH_PREFIX}${baseSlug}`;
const twinId = isZh ? enTwinId : zhTwinId;
const hasTwin = allPosts.some((p) => p.id === twinId);
const alternates = hasTwin
  ? [
      { hreflang: "en", href: `/blog/${enTwinId}/` },
      { hreflang: "zh-CN", href: `/blog/${zhTwinId}/` },
      { hreflang: "x-default", href: `/blog/${enTwinId}/` },
    ]
  : [];

// Pick 3 related posts by tag overlap, falling back to recency — same
// locale only, so a zh reader never gets steered to an English post.
// Internal links are a real SEO signal — every post that ships should
// link to 3 others, even if the overlap is loose.
const sameLocale = allPosts
  .filter((p) => p.id !== post.id && p.id.startsWith(ZH_PREFIX) === isZh);
const related = sameLocale
  .map((p) => {
    const overlap = p.data.tags.filter((t) => post.data.tags.includes(t)).length;
    return { post: p, overlap };
  })
  .sort((a, b) => {
    if (b.overlap !== a.overlap) return b.overlap - a.overlap;
    return b.post.data.publishedAt.valueOf() - a.post.data.publishedAt.valueOf();
  })
  .slice(0, 3)
  .map((r) => r.post);

// Per-page structured data:
//   - BlogPosting: tells Google this is an article (rich result eligible).
//   - BreadcrumbList: powers the breadcrumb trail in search results.
const schemas = [
  blogPostSchema({
    title: post.data.title,
    description: post.data.description,
    slug,
    publishedAt: post.data.publishedAt,
    updatedAt: post.data.updatedAt,
    author: post.data.author,
    tags: post.data.tags,
    inLanguage: lang,
  }),
  breadcrumbSchema([
    { name: ui.home, path: "/" },
    { name: ui.blog, path: blogIndex },
    { name: post.data.title, path: `/blog/${slug}/` },
  ]),
];
---

<Base
  title={post.data.title}
  description={post.data.description}
  canonical={`/blog/${slug}/`}
  ogType="article"
  publishedAt={post.data.publishedAt}
  updatedAt={post.data.updatedAt}
  schemas={schemas}
  keywords={post.data.tags.join(", ")}
  lang={lang}
  alternates={alternates}
>
  <article class="max-w-3xl mx-auto px-4 py-12">
    <!-- Breadcrumb (visible — supports the JSON-LD above) -->
    <nav aria-label="Breadcrumb" class="text-xs text-[var(--color-fg-subtle)] mb-6">
      <ol class="flex gap-2">
        <li><a href="/" class="hover:underline">{ui.home}</a></li>
        <li aria-hidden="true">/</li>
        <li><a href={blogIndex} class="hover:underline">{ui.blog}</a></li>
        <li aria-hidden="true">/</li>
        <li class="text-[var(--color-fg-muted)] truncate max-w-[12em]" aria-current="page" title={post.data.title}>
          {post.data.title}
        </li>
      </ol>
    </nav>

    <header class="mb-10">
      <div class="text-xs text-[var(--color-fg-subtle)] uppercase tracking-wider mb-2">
        <time datetime={post.data.publishedAt.toISOString()}>
          {formatDate(post.data.publishedAt)}
        </time>
        {post.data.author && <> · {post.data.author}</>}
        <span class="ml-2">· {minutes} {ui.minRead}</span>
        {post.data.updatedAt && (
          <span class="ml-2">
            ({ui.updated} <time datetime={post.data.updatedAt.toISOString()}>{formatDate(post.data.updatedAt)}</time>)
          </span>
        )}
        {hasTwin && (
          <span class="ml-2">· <a href={`/blog/${twinId}/`} hreflang={isZh ? "en" : "zh-CN"} class="hover:underline">{isZh ? "English" : "中文版"}</a></span>
        )}
      </div>
      <h1 class="font-display text-4xl font-bold tracking-tight mb-3">{post.data.title}</h1>
      <p class="text-lg text-[var(--color-fg-muted)]">{post.data.description}</p>
      {post.data.tags.length > 0 && (
        <div class="mt-4 flex gap-2 flex-wrap" aria-label="Tags">
          {post.data.tags.map((t) => (
            <span class="inline-block px-2 py-0.5 text-xs rounded bg-[var(--color-bg-surface)] text-[var(--color-fg-muted)]">
              {t}
            </span>
          ))}
        </div>
      )}
    </header>

    <div class="prose">
      <Content />
    </div>

    {related.length > 0 && (
      <aside class="mt-16 pt-8 border-t border-[var(--color-border)]" aria-labelledby="related-heading">
        <h2 id="related-heading" class="font-display text-xl font-semibold mb-5">{ui.relatedPosts}</h2>
        <div class="grid sm:grid-cols-3 gap-4">
          {related.map((r) => (
            <a
              href={`/blog/${r.id}/`}
              class="block border border-[var(--color-border)] rounded-lg p-4 hover:border-[var(--color-brand)] transition-colors no-underline"
            >
              <div class="text-xs text-[var(--color-fg-subtle)] mb-1">
                {formatDate(r.data.publishedAt)}
              </div>
              <div class="font-semibold text-sm mb-1 text-[var(--color-fg)]">
                {r.data.title}
              </div>
              <p class="text-xs text-[var(--color-fg-muted)] line-clamp-3">
                {r.data.description}
              </p>
            </a>
          ))}
        </div>
      </aside>
    )}

    <footer class="mt-12 pt-6 border-t border-[var(--color-border)] text-sm text-[var(--color-fg-muted)] flex flex-wrap gap-x-6 gap-y-2 justify-between">
      <a href={blogIndex} class="hover:underline">{ui.allPosts}</a>
      <a href="/blog/rss.xml" class="hover:underline">{ui.rss}</a>
    </footer>
  </article>
</Base>
