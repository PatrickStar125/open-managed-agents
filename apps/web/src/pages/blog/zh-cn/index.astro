---
import Base from "../../../layouts/Base.astro";
import { getCollection } from "astro:content";

// zh-CN index — mirrors ../index.astro but lists only posts under
// src/content/blog/zh-cn/ (id prefix "zh-cn/"). UI strings are
// translated inline; no i18n framework for a handful of labels.
const posts = (await getCollection("blog", ({ data }) => !data.draft))
  .filter((post) => post.id.startsWith("zh-cn/"))
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());

function formatDate(d: Date) {
  return d.toLocaleDateString("zh-CN", { year: "numeric", month: "long", day: "numeric" });
}
---

<Base
  title="博客"
  description="openma 博客 —— 关于智能体、基础设施以及构建它们的人。"
  canonical="/blog/zh-cn/"
  lang="zh-CN"
  alternates={[
    { hreflang: "en", href: "/blog/" },
    { hreflang: "zh-CN", href: "/blog/zh-cn/" },
    { hreflang: "x-default", href: "/blog/" },
  ]}
>
  <div class="max-w-3xl mx-auto px-4 py-12">
    <h1 class="font-display text-4xl font-bold mb-2">博客</h1>
    <p class="text-[var(--color-fg-muted)] mb-12">
      构建 openma 过程中的笔记。智能体设计、集成、计费，以及偶尔的事故复盘。
    </p>

    {posts.length === 0 && (
      <p class="text-[var(--color-fg-muted)]">还没有文章 —— 第一篇即将发布。</p>
    )}

    <ul class="space-y-8">
      {posts.map((post) => (
        <li>
          <article>
            <div class="text-xs text-[var(--color-fg-subtle)] uppercase tracking-wider mb-1">
              {formatDate(post.data.publishedAt)}
              {post.data.tags.length > 0 && (
                <span class="ml-2">
                  {post.data.tags.map((t) => (
                    <span class="ml-1 inline-block px-1.5 py-0.5 rounded bg-[var(--color-bg-surface)] text-[var(--color-fg-muted)] normal-case">
                      {t}
                    </span>
                  ))}
                </span>
              )}
            </div>
            <h2 class="font-display text-2xl font-semibold mb-1">
              <a href={`/blog/${post.id}/`} class="text-[var(--color-fg)]">{post.data.title}</a>
            </h2>
            <p class="text-[var(--color-fg-muted)]">{post.data.description}</p>
          </article>
        </li>
      ))}
    </ul>

    <p class="mt-12 text-sm text-[var(--color-fg-muted)]">
      <a href="/blog/" hreflang="en" class="hover:underline">English blog →</a>
    </p>
  </div>
</Base>
